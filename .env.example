# Resident Evil: Revelations (Wii U) - NEX server config.
# Optional: PN_REREV_LEGACY_SIGNATURE=0|1 (default 0, verified from a console capture).
# Copy to .env and fill in. All names are namespaced PN_REREV_*.

# --- PRUDP listeners ---
PN_REREV_AUTH_PORT=29100
PN_REREV_SECURE_PORT=29101
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates it into a ~15-char buffer. Use a bare LAN IP or
# hostname the console can dial, not a subdomain.
PN_REREV_SECURE_HOST=localhost

# --- Database (matchmaking + tracking, one database) ---
PN_REREV_POSTGRES_URI=postgres://rerev:rerev@localhost:5432/rerev?sslmode=disable

# --- Kerberos / system accounts ---
PN_REREV_KERBEROS_PASSWORD=change-me

# --- Auth mode --------------------------------------------------------------
# 1 = isolated preservation mode: accounts from settings.json, login token
#     not validated. Leave the two NEX_* vars below empty. Use only on an
#     isolated network.
PN_REREV_LOCAL_MODE=1
PN_REREV_SETTINGS_PATH=settings.json

# Required only when PN_REREV_LOCAL_MODE is not 1 (shared deployment behind
# a Pretendo-style account server):
#   PN_REREV_NEX_TOKEN_AES_KEY   64 hex chars (AES-256), matches the account server
#   PN_REREV_NEX_PASSWORD_SECRET >=32 bytes hex, matches the account server
PN_REREV_NEX_TOKEN_AES_KEY=
PN_REREV_NEX_PASSWORD_SECRET=
